# Mesmo RabbitMQ do fiscal-notes-api (infra/.env do workspace)
RABBITMQ_URL=amqp://fiscal:troque-me@127.0.0.1:5672
READER_QUEUE=reader.infosimples.v1
RESULTS_QUEUE=fiscal.results
PREFETCH=2
# Token da API Infosimples (painel > Tokens). Nunca commitar.
INFOSIMPLES_TOKEN=
# Timeout repassado à Infosimples, em segundos
INFOSIMPLES_TIMEOUT_S=300
