{
  "name": "fiscal-notes-reader-infosimples",
  "version": "0.1.0",
  "private": true,
  "description": "Leitor de NFC-e de MG via API paga da Infosimples: consome reader.infosimples.v1 e publica o resultado normalizado.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "yarn build && yarn start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 120000
  },
  "dependencies": {
    "ajv": "^8",
    "ajv-formats": "^3",
    "amqplib": "^0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/amqplib": "^0.10",
    "@types/jest": "^29",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^15",
    "jest": "^29",
    "prettier": "^3",
    "testcontainers": "^10",
    "ts-jest": "^29",
    "typescript": "~5.7",
    "typescript-eslint": "^8"
  },
  "packageManager": "yarn@4.5.3+sha512.3003a14012e2987072d244c720506549c1aab73ee728208f1b2580a9fd67b92d61ba6b08fe93f6dce68fd771e3af1e59a0afa28dd242dd0940d73b95fedd4e90"
}
